# F1 Telemetry Simulator - Environment Configuration
# Copy this file to .env and modify as needed

# API Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=F1 Telemetry Simulator
VERSION=1.0.0

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Telemetry Settings
DEFAULT_TARGET_HOST=telemetry-ingest
DEFAULT_TARGET_PORT=20777
DEFAULT_PACKET_RATE_HZ=60

# Simulation Settings
MAX_CONCURRENT_SIMULATIONS=5
DEFAULT_SIMULATION_MODE=race
