{
    "name": "F1 Telemetry Frontend (React + TypeScript)",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "target": "development"
    },
    "workspaceFolder": "/workspaces/F1-Telemetry/services/telemetry-frontend",
    "runArgs": ["--network=host"],
    
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },
    
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "bradlc.vscode-tailwindcss",
                "dsznajder.es7-react-js-snippets",
                "christian-kohler.npm-intellisense",
                "christian-kohler.path-intellisense",
                "formulahendry.auto-rename-tag"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.fixAll.eslint": "explicit"
                },
                "typescript.tsdk": "node_modules/typescript/lib",
                "typescript.enablePromptUseWorkspaceTsdk": true,
                "eslint.validate": [
                    "javascript",
                    "javascriptreact",
                    "typescript",
                    "typescriptreact"
                ]
            }
        }
    },
    
    "forwardPorts": [5173, 3000],
    "portsAttributes": {
        "5173": {
            "label": "Vite Dev Server"
        },
        "3000": {
            "label": "Production Preview"
        }
    },
    
    "postCreateCommand": "npm install",
    
    "remoteUser": "root",
    
    "mounts": [
        "source=telemetry-frontend-node-modules,target=/workspaces/F1-Telemetry/services/telemetry-frontend/node_modules,type=volume"
    ]
}
