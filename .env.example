# F1 Telemetry System Configuration

# Telemetry Ingest Service
UDP_LISTEN_PORT=20777
ZMQ_PUBLISHER_ENDPOINT=tcp://*:5555

# Telemetry Processor Service
ZMQ_SUBSCRIBER_ENDPOINT=tcp://telemetry-ingest:5555
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
MODE=passthrough  # Options: passthrough, datacollection

# Telemetry Frontend Service
VITE_WEBSOCKET_URL=ws://localhost:8765

# Logging
LOG_LEVEL=info  # Options: debug, info, warning, error

# Future: Kafka Configuration (when migrating from ZeroMQ)
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_TOPIC_TELEMETRY=f1-telemetry
# KAFKA_CONSUMER_GROUP=telemetry-processor

# Future: Database Configuration
# INFLUXDB_URL=http://influxdb:8086
# INFLUXDB_TOKEN=your-token
# INFLUXDB_ORG=f1-telemetry
# INFLUXDB_BUCKET=telemetry-data
